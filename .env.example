# Copy this file to '.env' and fill in your details

# Django secret key (required in production)
DJANGO_SECRET_KEY=your_django_secret_key_here

# Django debug mode (set to False in production)
DJANGO_DEBUG=True

# Allowed hosts (comma-separated, e.g. "127.0.0.1,localhost,yourdomain.com")
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Get your free Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
